<%- include('../layouts/header') %>

<div class="auth-wrapper" style="max-width: 520px;">
  <div class="auth-card">
    <div class="auth-header">
      <div class="brand-shield" style="margin: 0 auto 1rem; width: 48px; height: 48px; background: linear-gradient(135deg, #dc2626, #b91c1c);">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
          <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/>
        </svg>
      </div>
      <h1>Disable Two-Factor Authentication</h1>
      <p>Confirm your identity to remove 2FA security</p>
    </div>

    <div class="alert alert-error" style="margin-bottom: 1.5rem;">
      <div class="alert-content">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        <div>
          <strong>Warning:</strong> Disabling 2FA will remove extra authentication layers and invalidate all existing recovery codes. Your account will rely solely on password security.
        </div>
      </div>
    </div>

    <form action="/2fa/disable" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="token" class="otp-hidden-value" value="">

      <!-- Password Confirmation -->
      <div class="form-group">
        <label for="password" class="form-label">Current Account Password</label>
        <input
          type="password"
          id="password"
          name="password"
          class="form-control"
          placeholder="Enter your current password"
          required
          autofocus
        >
      </div>

      <!-- 2FA Authorization Method Tabs -->
      <div class="tabs-nav" style="margin-top: 1.25rem; margin-bottom: 1rem;">
        <button
          type="button"
          class="tab-btn active"
          data-tab-target="disable-tab-otp"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          Authenticator OTP
        </button>
        <button
          type="button"
          class="tab-btn"
          data-tab-target="disable-tab-recovery"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
          Use Recovery Code
        </button>
      </div>

      <!-- Option 1: OTP Confirmation -->
      <div id="disable-tab-otp" class="tab-panel">
        <label class="form-label" style="text-align: center; display: block;">Current 6-Digit Authenticator Code</label>
        <p class="form-hint" style="text-align: center; margin-bottom: 0.5rem;">Enter the code from your authenticator app to authorize this action:</p>

        <div class="otp-container" style="margin: 0.5rem 0 1.25rem;">
          <input type="text" inputmode="numeric" maxlength="1" class="otp-box">
          <input type="text" inputmode="numeric" maxlength="1" class="otp-box">
          <input type="text" inputmode="numeric" maxlength="1" class="otp-box">
          <input type="text" inputmode="numeric" maxlength="1" class="otp-box">
          <input type="text" inputmode="numeric" maxlength="1" class="otp-box">
          <input type="text" inputmode="numeric" maxlength="1" class="otp-box">
        </div>
      </div>

      <!-- Option 2: Recovery Code Confirmation -->
      <div id="disable-tab-recovery" class="tab-panel" style="display: none;">
        <label for="recoveryTokenInput" class="form-label">Emergency Recovery Code</label>
        <p class="form-hint" style="margin-bottom: 0.5rem;">If you lost access to your authenticator, enter an unused recovery code (e.g. <code>ABCD-1234</code>):</p>
        <input
          type="text"
          id="recoveryTokenInput"
          name="recoveryCode"
          class="form-control"
          placeholder="e.g. 7X3K-9B2F"
          style="font-family: var(--font-mono); font-weight: 700; text-transform: uppercase; font-size: 1.05rem; text-align: center; letter-spacing: 0.1em; margin-bottom: 1.25rem;"
          autocomplete="off"
        >
      </div>

      <button type="submit" class="btn btn-danger btn-block btn-lg">
        Confirm &amp; Disable 2FA
      </button>
    </form>

    <div class="auth-footer">
      <a href="/dashboard" class="btn btn-secondary btn-sm">Cancel and Return to Dashboard</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
