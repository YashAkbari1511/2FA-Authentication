<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Two-Factor Authentication Demo' %></title>
  
  <!-- Inter Font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  
  <!-- Stylesheets -->
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
  <!-- Header / Navigation -->
  <header class="navbar">
    <div class="nav-container">
      <a href="/" class="brand">
        <span class="brand-shield">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
          </svg>
        </span>
        <span>SecureAuth 2FA</span>
      </a>

      <nav>
        <ul class="nav-links">
          <li>
            <a href="/info" class="btn btn-secondary btn-sm">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
              How 2FA Works
            </a>
          </li>
          <% if (typeof currentUser !== 'undefined' && currentUser) { %>
            <li><a href="/dashboard" class="btn btn-outline btn-sm">Dashboard</a></li>
            <li>
              <form action="/auth/logout" method="POST" style="display: inline;">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <button type="submit" class="btn btn-secondary btn-sm">Sign Out</button>
              </form>
            </li>
          <% } else { %>
            <li><a href="/" class="btn btn-secondary btn-sm">Home</a></li>
            <li><a href="/auth/login" class="btn btn-outline btn-sm">Sign In</a></li>
            <li><a href="/auth/register" class="btn btn-primary btn-sm">Get Started</a></li>
          <% } %>
        </ul>
      </nav>
    </div>
  </header>

  <!-- Flash Messages Banner -->
  <%- include('alerts') %>

  <!-- Main Content Wrapper -->
  <main style="flex: 1 0 auto; width: 100%;">
