<%- include('../layouts/header') %>

<div class="auth-wrapper">
  <div class="auth-card">
    <div class="auth-header">
      <div class="brand-shield" style="margin: 0 auto 1rem; width: 44px; height: 44px;">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/>
        </svg>
      </div>
      <h1>Create Demo Account</h1>
      <p>Register to explore full 2FA authentication flow</p>
    </div>

    <form action="/auth/register" method="POST" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="name" class="form-label">Full Name</label>
        <input
          type="text"
          id="name"
          name="name"
          class="form-control"
          placeholder="e.g. John Doe"
          value="<%= typeof formData !== 'undefined' && formData.name ? formData.name : '' %>"
          required
          autofocus
        >
      </div>

      <div class="form-group">
        <label for="email" class="form-label">Email Address</label>
        <input
          type="email"
          id="email"
          name="email"
          class="form-control"
          placeholder="name@example.com"
          value="<%= typeof formData !== 'undefined' && formData.email ? formData.email : '' %>"
          required
        >
      </div>

      <div class="form-group">
        <label for="regPassword" class="form-label">Password</label>
        <input
          type="password"
          id="regPassword"
          name="password"
          class="form-control"
          placeholder="Minimum 8 characters (letters & numbers)"
          required
        >
        <!-- Password Strength Indicator -->
        <div style="margin-top: 0.5rem;">
          <div style="height: 4px; width: 100%; background-color: #e2e8f0; border-radius: 2px; overflow: hidden;">
            <div id="passwordStrengthBar" style="height: 100%; width: 0%; transition: width 0.3s, background-color 0.3s;"></div>
          </div>
          <div style="display: flex; justify-content: space-between; font-size: 0.75rem; margin-top: 0.25rem;">
            <span class="form-hint">At least 8 chars with letters &amp; numbers</span>
            <span id="passwordStrengthText" style="font-weight: 600;"></span>
          </div>
        </div>
      </div>

      <div class="form-group">
        <label for="confirmPassword" class="form-label">Confirm Password</label>
        <input
          type="password"
          id="confirmPassword"
          name="confirmPassword"
          class="form-control"
          placeholder="Re-enter your password"
          required
        >
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 1.5rem;">
        Register Account
      </button>
    </form>

    <div class="auth-footer">
      Already have an account? <a href="/auth/login" style="font-weight: 600;">Sign in here</a>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
