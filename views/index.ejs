<%- include('layouts/header') %>

<div style="max-width: 1200px; margin: 2rem auto; padding: 0 1.5rem;">
  <!-- Hero Section -->
  <section style="text-align: center; padding: 3rem 1rem; background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%); border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); margin-bottom: 2.5rem;">
    <div style="display: inline-flex; align-items: center; gap: 0.5rem; background: var(--primary-light); color: var(--primary); padding: 0.35rem 0.85rem; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600; margin-bottom: 1.25rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      RFC 6238 TOTP Implementation
    </div>

    <h1 style="font-size: 2.5rem; max-width: 800px; margin: 0 auto 1.25rem; letter-spacing: -0.02em;">
      Production-Grade Two-Factor Authentication (2FA) Demo
    </h1>
    <p style="font-size: 1.15rem; max-width: 680px; margin: 0 auto 2rem; color: var(--text-secondary);">
      Built strictly using <strong>Node.js, Express, and MongoDB</strong>. Experience complete TOTP enrollment via QR code, authenticator verification, AES-256-GCM encryption at rest, and emergency recovery codes.
    </p>

    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <% if (isAuth) { %>
        <a href="/dashboard" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
          Go to Dashboard
        </a>
      <% } else { %>
        <a href="/auth/register" class="btn btn-primary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
          Register Demo Account
        </a>
        <a href="/auth/login" class="btn btn-secondary btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
          Sign In
        </a>
      <% } %>
    </div>
  </section>

  <!-- How 2FA Works -->
  <section style="margin-bottom: 3rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">How Time-Based 2FA Works</h2>
      <p>A multi-layered defense mechanism protecting accounts from password breaches.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem;">
      <div class="auth-card" style="padding: 1.5rem; text-align: left;">
        <div style="width: 40px; height: 40px; background: var(--primary-light); color: var(--primary); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-weight: bold; margin-bottom: 1rem;">1</div>
        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Primary Login</h3>
        <p style="font-size: 0.9rem;">User authenticates with email and bcrypt-hashed password. System flags account as pending 2FA.</p>
      </div>

      <div class="auth-card" style="padding: 1.5rem; text-align: left;">
        <div style="width: 40px; height: 40px; background: #e0f2fe; color: #0284c7; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-weight: bold; margin-bottom: 1rem;">2</div>
        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Authenticator App</h3>
        <p style="font-size: 0.9rem;">Google or Microsoft Authenticator uses shared secret and current Unix timestamp to generate a rotating 6-digit code.</p>
      </div>

      <div class="auth-card" style="padding: 1.5rem; text-align: left;">
        <div style="width: 40px; height: 40px; background: #fef3c7; color: #d97706; border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-weight: bold; margin-bottom: 1rem;">3</div>
        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Server Verification</h3>
        <p style="font-size: 0.9rem;">Speakeasy validates the token within a drift window. AES-256-GCM decrypts secret safely in memory.</p>
      </div>

      <div class="auth-card" style="padding: 1.5rem; text-align: left;">
        <div style="width: 40px; height: 40px; background: var(--success-bg); color: var(--success); border-radius: var(--radius-md); display: flex; align-items: center; justify-content: center; font-weight: bold; margin-bottom: 1rem;">4</div>
        <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem;">Session Granted</h3>
        <p style="font-size: 0.9rem;">Session is regenerated to prevent fixation. Full dashboard access granted with single-use recovery code backup.</p>
      </div>
    </div>
  </section>

  <!-- Security Features Grid -->
  <section style="margin-bottom: 3rem;">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Engineered for Strict Security</h2>
      <p>Following OWASP best practices for identity verification and session handling.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
      <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.5rem; display: flex; gap: 1rem;">
        <div style="color: var(--primary);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>
        <div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.35rem;">AES-256-GCM Encrypted Secrets</h4>
          <p style="font-size: 0.875rem;">TOTP secrets are encrypted at rest with an authentication tag. Even database snapshots never reveal plain secrets.</p>
        </div>
      </div>

      <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.5rem; display: flex; gap: 1rem;">
        <div style="color: var(--success);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 11 12 14 22 4"/></svg></div>
        <div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.35rem;">Hashed Single-Use Recovery Codes</h4>
          <p style="font-size: 0.875rem;">Generates 10 emergency codes. Codes are stored using bcrypt hashing and marked consumed immediately upon use.</p>
        </div>
      </div>

      <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.5rem; display: flex; gap: 1rem;">
        <div style="color: var(--danger);"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"/></svg></div>
        <div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.35rem;">Brute-Force Rate Limiting</h4>
          <p style="font-size: 0.875rem;">Rate-limiting middleware strictly throttles OTP guesses and login attempts to prevent automated dictionary attacks.</p>
        </div>
      </div>

      <div style="background: white; border: 1px solid var(--border); border-radius: var(--radius-md); padding: 1.5rem; display: flex; gap: 1rem;">
        <div style="color: #6366f1;"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/></svg></div>
        <div>
          <h4 style="font-size: 1.05rem; margin-bottom: 0.35rem;">Session Fixation Protection</h4>
          <p style="font-size: 0.875rem;">Session IDs are regenerated at both primary login and 2FA OTP verification stages. Restricted temporary state prevents bypass.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete Demo Flow Guide -->
  <section style="background: #ffffff; border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 2rem; box-shadow: var(--shadow-sm); margin-bottom: 3rem;">
    <h3 style="font-size: 1.25rem; margin-bottom: 1rem;">Complete Step-by-Step Demo Flow</h3>
    <ol style="margin-left: 1.5rem; color: var(--text-secondary); line-height: 1.8;">
      <li>Click <strong><a href="/auth/register">Create Account</a></strong> to register a new user.</li>
      <li>Sign in with your email and password to open the <strong>Dashboard</strong>.</li>
      <li>Click <strong>Enable Two-Factor Authentication</strong>.</li>
      <li>Scan the QR code with <strong>Google Authenticator</strong>, <strong>Microsoft Authenticator</strong>, or copy the base32 key.</li>
      <li>Enter the 6-digit OTP code to verify and activate 2FA.</li>
      <li>Download or copy your <strong>10 Emergency Recovery Codes</strong>.</li>
      <li>Log out and log back in: notice that access is blocked until you provide the rotating 6-digit OTP code!</li>
      <li>Test logging in with a <strong>Recovery Code</strong> as a backup.</li>
      <li>Disable or reconfigure 2FA at any time with password &amp; OTP confirmation.</li>
    </ol>
  </section>
</div>

<%- include('layouts/footer') %>
