        </h3>
        <p style="font-size: 0.875rem; margin: 0.5rem 0;">
          Create a Base32 secret and encode it into an <code>otpauth://</code> format URL with your app name and user email:
        </p>
        <div class="code-container">
          <div class="code-header">
            <span>services/twoFactorService.js</span>
            <button type="button" data-copy="#codeStep1">Copy</button>
          </div>
          <pre class="code-block" id="codeStep1">const speakeasy = require('speakeasy');
const QRCode = require('qrcode');

function getTOTPAuthUrl(userEmail, base32Secret) {
  return speakeasy.otpauthURL({
    secret: base32Secret,
    label: `2FA Demo App (${userEmail})`,
    issuer: '2FA Demo App',
    encoding: 'base32',
  });
}

function generateTOTPSecret(userEmail) {
  const secret = speakeasy.generateSecret({ length: 20 });
  return {
    base32: secret.base32,
    otpauth_url: getTOTPAuthUrl(userEmail, secret.base32),
  };
}

async function generateQRCodeDataURL(otpauthUrl) {
  return QRCode.toDataURL(otpauthUrl, {
    errorCorrectionLevel: 'M',
    margin: 2,
    scale: 6,
  });
}</pre>
        </div>
      </div>

      <!-- Step 2 -->
      <div style="margin-bottom: 2rem;">
        <h3 style="font-size: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
          <span class="flow-step-num" style="width: 28px; height: 28px; font-size: 0.85rem;">2</span>
          Encrypt Secrets at Rest with AES-256-GCM
        </h3>
        <p style="font-size: 0.875rem; margin: 0.5rem 0;">
          Never save raw Base32 keys in database documents. Encrypt them using AES-256 authenticated encryption:
        </p>
        <div class="code-container">
          <div class="code-header">
            <span>utils/cryptoUtil.js</span>
            <button type="button" data-copy="#codeStep2">Copy</button>
          </div>
          <pre class="code-block" id="codeStep2">const crypto = require('crypto');

const ALGORITHM = 'aes-256-gcm';
const IV_LENGTH = 12; // 96 bits for GCM

function getEncryptionKey() {
  return crypto.createHash('sha256').update(process.env.ENCRYPTION_KEY).digest();
}

function encrypt(text) {
  if (!text) return null;
  const iv = crypto.randomBytes(IV_LENGTH);
  const cipher = crypto.createCipheriv(ALGORITHM, getEncryptionKey(), iv);
  let encrypted = cipher.update(text, 'utf8', 'hex');
  encrypted += cipher.final('hex');
  const authTag = cipher.getAuthTag().toString('hex');
  return `${iv.toString('hex')}:${authTag}:${encrypted}`;
}

function decrypt(encryptedString) {
  if (!encryptedString) return null;
  const [ivHex, authTagHex, encryptedData] = encryptedString.split(':');
  const decipher = crypto.createDecipheriv(ALGORITHM, getEncryptionKey(), Buffer.from(ivHex, 'hex'));
  decipher.setAuthTag(Buffer.from(authTagHex, 'hex'));
  let decrypted = decipher.update(encryptedData, 'hex', 'utf8');
  decrypted += decipher.final('utf8');
  return decrypted;
}</pre>
