          </div>
          <pre class="code-block" id="codeStep3">function verifyTOTPToken(secret, token) {
  if (!secret || !token) return false;
  return speakeasy.totp.verify({
    secret,
    encoding: 'base32',
    token: String(token).trim(),
    window: 1, // allows +/- 30 seconds drift (90 seconds total)
  });
}

// In verify-setup controller:
const isValid = verifyTOTPToken(tempSecret, token);
if (!isValid) {
  req.flash('error', 'Invalid verification code.');
  return res.redirect('/2fa/setup');
}

// Promote temporary secret to active secret
user.twoFactorSecret = user.temporaryTwoFactorSecret;
user.temporaryTwoFactorSecret = null;
user.twoFactorEnabled = true;
await user.save();</pre>
