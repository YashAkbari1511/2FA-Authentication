      <!-- Step 4 -->
      <div style="margin-bottom: 2rem;">
        <h3 style="font-size: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
          <span class="flow-step-num" style="width: 28px; height: 28px; font-size: 0.85rem;">4</span>
          Generate &amp; Hash Single-Use Recovery Codes
        </h3>
        <p style="font-size: 0.875rem; margin: 0.5rem 0;">
          Generate 10 human-readable backup codes. Store only their bcrypt hashes in MongoDB:
        </p>
        <div class="code-container">
          <div class="code-header">
            <span>services/recoveryCodeService.js</span>
            <button type="button" data-copy="#codeStep4">Copy</button>
          </div>
          <pre class="code-block" id="codeStep4">const bcrypt = require('bcrypt');
const crypto = require('crypto');

async function generateRecoveryCodes() {
  const plainCodes = [];
  const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';

  while (plainCodes.length &lt; 10) {
    const bytes = crypto.randomBytes(8);
    let code = '';
    for (let i = 0; i &lt; 8; i++) {
      if (i === 4) code += '-';
      code += chars[bytes[i] % chars.length];
    }
    if (!plainCodes.includes(code)) plainCodes.push(code);
  }

  const hashedCodes = await Promise.all(
    plainCodes.map(async (code) => ({
      codeHash: await bcrypt.hash(code, 10),
      used: false,
      usedAt: null,
    }))
  );

  return { plainCodes, hashedCodes };
}</pre>
