        </h3>
        <p style="font-size: 0.875rem; margin: 0.5rem 0;">
          Do not grant full session access upon primary password authentication. Regenerate the session ID at each stage:
        </p>
        <div class="code-container">
          <div class="code-header">
            <span>controllers/authController.js &amp; middleware/authMiddleware.js</span>
            <button type="button" data-copy="#codeStep5">Copy</button>
          </div>
          <pre class="code-block" id="codeStep5">// Primary login:
if (user.twoFactorEnabled) {
  req.session.regenerate((err) => {
    req.session.pendingUserId = user._id.toString();
    req.session.is2FAVerified = false;
    req.session.save(() => res.redirect('/2fa/verify'));
  });
  return;
}

// Verification middleware:
function isAuthenticated(req, res, next) {
  if (!req.session.userId || req.session.is2FAVerified !== true) {
    if (req.session.pendingUserId) return res.redirect('/2fa/verify');
    return res.redirect('/auth/login');
  }
  next();
}</pre>
