      <!-- Step 6 -->
      <div>
        <h3 style="font-size: 1.2rem; display: flex; align-items: center; gap: 0.5rem;">
          <span class="flow-step-num" style="width: 28px; height: 28px; font-size: 0.85rem;">6</span>
          Rate Limiting Against Brute-Force Attacks
        </h3>
        <p style="font-size: 0.875rem; margin: 0.5rem 0;">
          Since 6-digit OTP codes have only 1,000,000 possible combinations, strict rate limiting is mandatory:
        </p>
        <div class="code-container">
          <div class="code-header">
            <span>middleware/rateLimiter.js</span>
            <button type="button" data-copy="#codeStep6">Copy</button>
          </div>
